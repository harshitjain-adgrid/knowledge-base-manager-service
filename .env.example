# ── Environment ──
ENVIRONMENT=development

# ── Database ──
# The control plane (admin users, sessions, the knowledge-base registry) and the
# default knowledge base's own storage. Additional knowledge bases are added
# through the UI and keep their connection strings in the registry, encrypted.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chotu_rag

# ── Secrets ──
# Encrypts the connection strings of additional knowledge bases before they are
# stored, so a database dump does not hand over credentials to other hosts.
# Required only if you add a second knowledge base. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes already-saved connection strings unreadable.
SECRET_KEY=

# ── Embedding provider: "gemini" | "fal" ──
EMBEDDING_PROVIDER=gemini

# Google Gemini (AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# fal.ai OpenRouter
FAL_KEY=your-fal-key-here

# ── Embedding config ──
# These configure the DEFAULT knowledge base. Additional ones choose their own
# model when they are created, and it cannot be changed afterwards.
# gemini -> gemini-embedding-2 | fal -> openai/text-embedding-3-large
# fal    -> openai/text-embedding-3-large (note the "openai/" router prefix)
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=3072
MAX_EMBEDDING_BATCH_SIZE=20
# Gemini free tier = 100 embed requests/min; each text in a batch counts as one.
EMBEDDING_REQUESTS_PER_MINUTE=90

# ── Chunking config ──
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# ── File Uploads ──
MAX_UPLOAD_SIZE_MB=20

# ── Auth ──
# Auth is always on. Create users with:
#   python -m app.admin_cli create <username>
SESSION_TTL_HOURS=12
# Optional machine key for scripts and curl. Not needed by the admin UI.
ADMIN_API_KEY=

# ── CORS ──
# Leave empty for the normal deployment, where this service also serves the UI
# and requests are same-origin. Only set this if the frontend is hosted
# separately, e.g. CORS_ORIGINS=https://kb.vercel.app
CORS_ORIGINS=
